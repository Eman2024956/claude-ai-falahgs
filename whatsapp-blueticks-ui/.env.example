# Blueticks MCP endpoint (copy the exact URL from your Blueticks dashboard -> MCP / API)
BLUETICKS_MCP_URL=https://api.blueticks.co/mcp
# Your Blueticks API key from the Blueticks "API" page (normally starts with bt_live_), sent as "Authorization: Bearer <key>"
BLUETICKS_API_KEY=your-blueticks-api-key
# Optional: which of your WhatsApp numbers to use when the account has several (E.164 or numberId)
BLUETICKS_FROM_NUMBER=
# Local server port
PORT=3000
