# ===================== Blueticks =====================
# Which Blueticks API to use: auto | rest | mcp
#   rest = REST API (POST /messages, apiKey in the body). Sends text, media URL, scheduled messages.
#   mcp  = MCP server (bt_live_ key). Chats, contacts, history, polls, file upload.
#   auto = mcp if the key starts with bt_live_, otherwise rest
BLUETICKS_MODE=auto
# REST server. PRODUCTION: https://api.blueticks.co   (staging: https://stg-api.blueticks.co)
# A key only works on its own server: use your PRODUCTION key with api.blueticks.co.
BLUETICKS_REST_URL=https://api.blueticks.co
# Your Blueticks API key (from the Blueticks extension/app → API)
BLUETICKS_API_KEY=your-production-api-key
# MCP endpoint (only for bt_live_ keys)
BLUETICKS_MCP_URL=https://api.blueticks.co/mcp
# Optional (MCP): which of your WhatsApp numbers sends, if the account has several
BLUETICKS_FROM_NUMBER=

# ===================== Server =====================
NODE_ENV=production
PORT=3000
# 127.0.0.1 = only through Nginx/Caddy (recommended). Docker sets 0.0.0.0 itself.
HOST=127.0.0.1
# Number of reverse proxies in front of the app (Nginx = 1)
TRUST_PROXY=1

# ===================== Security =====================
# Login for the web UI (required when NODE_ENV=production, at least 10 characters)
APP_USERNAME=admin
APP_PASSWORD=change-me-to-a-long-password

# ===================== Delivery reports =====================
# Your public HTTPS address. Blueticks calls  PUBLIC_URL/api/callback/CALLBACK_SECRET  when a message is sent / fails.
PUBLIC_URL=https://wa.example.com
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CALLBACK_SECRET=

# ===================== Limits =====================
MAX_RECIPIENTS_PER_SEND=500
MIN_DELAY_SECONDS=2
SEND_REQUESTS_PER_MINUTE=10
# Where message history is stored
DATA_DIR=./data
# Allow /api/source.zip in production (default: off)
ALLOW_SOURCE_DOWNLOAD=false
