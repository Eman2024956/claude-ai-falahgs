# Which Blueticks API to use: auto | rest | mcp
#   rest = REST API (POST https://api.blueticks.co/messages, apiKey in body). Send only: text, media URL, schedule.
#   mcp  = MCP server (bt_live_ key). Chats, contacts, history, polls, file upload.
#   auto = mcp if the key starts with bt_live_, otherwise rest
BLUETICKS_MODE=auto
# Blueticks REST API base URL (production: https://api.blueticks.co, staging: https://stg-api.blueticks.co)
# Keys are per server: a staging key only works on stg-api, a production key only on api.
BLUETICKS_REST_URL=https://api.blueticks.co
# Blueticks MCP endpoint (copy the exact URL from your Blueticks dashboard -> MCP / API)
BLUETICKS_MCP_URL=https://api.blueticks.co/mcp
# Your Blueticks API key. A REST API key (e.g. yYBiIMwqvUWBWWzxEyvPzIuIGrGcHgJG) or an MCP key (bt_live_...)
BLUETICKS_API_KEY=your-blueticks-api-key
# Optional: which of your WhatsApp numbers to use when the account has several (E.164 or numberId)
BLUETICKS_FROM_NUMBER=
# Local server port
PORT=3000
