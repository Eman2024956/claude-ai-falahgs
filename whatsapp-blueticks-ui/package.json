{
  "name": "whatsapp-blueticks-ui",
  "version": "1.0.0",
  "description": "Web UI on top of the Blueticks WhatsApp MCP server: filter & select mobile numbers, preview chats, send messages, export ZIP.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mock": "node mock-mcp.mjs",
    "prod": "NODE_ENV=production node server.js",
    "docker:up": "docker compose up -d --build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  }
}
